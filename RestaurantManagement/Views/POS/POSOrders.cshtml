@using RestaurantManagement.Areas.Dashboard.ViewModels
@using RestaurantManagement.Models

@model POSOrdersViewModel

@{
    ViewData["Title"] = "Orders";
}

<link rel="stylesheet"
      href="~/css/POSOrders.css" />

<div class="pos-orders"
     id="posOrders"
     data-update-status-url="@Url.Action("UpdateOrderStatus", "POS")"
     data-orders-url="@Url.Action("POSOrders", "POS")">

    <div class="orders-card">

        <!-- =================================================
             FILTER TOOLBAR
        ================================================== -->

        <div id="ordersFilterToolbar"
             class="orders-toolbar">

            <!-- Search -->

            <div class="search-box">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">

                    <circle cx="11"
                            cy="11"
                            r="7" />

                    <path d="m20 20-3.5-3.5" />

                </svg>

                <input type="search"
                       id="ordersSearch"
                       value="@Model.Filter.Search"
                       placeholder="Search table or item..." />

            </div>


            <!-- =================================================
                 STATUS FILTER
            ================================================== -->

            <div class="status-filter"
                 id="statusFilter">

                <!-- Default -->

                <button type="button"
                        class="status-filter-btn status-default @(Model.Filter.Status is null && !Model.Filter.ShowAllStatuses ? "active" : "")"
                        data-status="default">

                    Default

                </button>


                <!-- All -->

                <button type="button"
                        class="status-filter-btn status-all @(Model.Filter.ShowAllStatuses ? "active" : "")"
                        data-status="all">

                    All

                </button>


                <!-- Statuses -->

                @foreach (var status in Enum.GetValues<OrderStatus>())
                {
                    var isActive =
                        Model.Filter.Status == status;

                    <button type="button"
                            class="status-filter-btn status-@status.ToString().ToLower() @(isActive ? "active" : "")"
                            data-status="@((int)status)">

                        @status

                    </button>
                }

            </div>


            <!-- =================================================
                 SORT
            ================================================== -->

            <select id="ordersSort"
                    class="filter-select">

                @if (Model.Filter.Sort == "oldest")
                {
                    <option value="oldest" selected>
                        Oldest
                    </option>
                }
                else
                {
                    <option value="oldest">
                        Oldest
                    </option>
                }

                @if (Model.Filter.Sort == "newest")
                {
                    <option value="newest" selected>
                        Newest
                    </option>
                }
                else
                {
                    <option value="newest">
                        Newest
                    </option>
                }

                @if (Model.Filter.Sort == "price-high")
                {
                    <option value="price-high" selected>
                        Highest Price
                    </option>
                }
                else
                {
                    <option value="price-high">
                        Highest Price
                    </option>
                }

                @if (Model.Filter.Sort == "price-low")
                {
                    <option value="price-low" selected>
                        Lowest Price
                    </option>
                }
                else
                {
                    <option value="price-low">
                        Lowest Price
                    </option>
                }

            </select>
            <div class="results-info">

                <strong id="ordersTotalCount">
                    @Model.TotalCount
                </strong>

                <span>
                    orders
                </span>

            </div>
            </div>


        <!-- =================================================
             ANTI FORGERY
        ================================================== -->

        @Html.AntiForgeryToken()

    </div>
        <!-- =================================================
             TABLE
        ================================================== -->
        <div class="orders-table-card">
        <div id="ordersTableWrapper"
             class="orders-table-wrapper">

            @await Html.PartialAsync(
                "_POSOrdersTable",
                Model)

        </div>


        </div>



</div>


@section Scripts {

    <script src="~/js/POSOrders.js"
            asp-append-version="true"></script>

}