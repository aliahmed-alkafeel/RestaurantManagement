@using RestaurantManagement.Areas.Dashboard.ViewModels
@model List<OrderViewModel>

@{
    ViewData["Title"] = "Orders";
}

<link rel="stylesheet"
      href="~/css/POSOrders.css" />

<div class="pos-orders">

    <!-- Header -->
    @* <div class="pos-header" style="z-index:55">
        <div class="search-box">
            <svg viewBox="0 0 24 24" fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round">
                <circle cx="11" cy="11" r="7" />
                <path d="m21 21-4.3-4.3" />
            </svg>

            <input type="text"
                   id="search"
                   placeholder="Search table number..." />
        </div>
    </div> *@

    <!-- Orders -->
    <div class="orders-card">

        <div class="orders-table-wrapper">
            @Html.AntiForgeryToken()
            <table id="ordersTable" class="orders-table">

                <thead>
                    <tr>
                        <th>Table</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Items</th>
                        <th>Order Date</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var order in Model)
                    {
                        <tr data-table="@order.TableId"
                            data-order-id="@order.Id"
                            class="order-row status-@order.OrderStatus.ToString().ToLower()">

                            <td>
                                <div class="table-info">
                                    <span class="table-icon">
                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">
                                            <rect x="3" y="8" width="18" height="3" rx="1" />
                                            <path d="M6 11v7" />
                                            <path d="M18 11v7" />
                                        </svg>
                                    </span>

                                    <div>
                                        <span class="table-label">Table</span>
                                        <strong>@order.TableId</strong>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <span class="total-price">
                                    @order.TotalPrice.ToString("F2")
                                </span>
                            </td>

                            <td>
                                <select class="status-select"
                                        data-order-id="@order.Id">

                                    @foreach (var status in Enum.GetValues<OrderStatus>())
                                    {
                                        <option value="@((int)status)"
                                                selected="@(status == order.OrderStatus)">
                                            @status
                                        </option>
                                    }

                                </select>
                            </td>

                            <!-- Items -->
                            <td>
                                <div class="order-items">

                                    @foreach (var item in order.ItemOrders)
                                    {
                                        <span class="order-item">
                                            <span class="item-name">
                                                @item.ItemName
                                            </span>

                                            <span class="item-quantity">
                                                × @item.Quantity
                                            </span>
                                        </span>
                                    }

                                </div>
                            </td>

                            <!-- Order Date -->
                            <td>
                                <span class="order-date">
                                    @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </td>

                        </tr>
                    }

                </tbody>
                <tbody>

                    @foreach (var order in Model)
                    {
                        <tr data-table="@order.TableId"
                            data-order-id="@order.Id"
                            class="order-row status-@order.OrderStatus.ToString().ToLower()">
                            <td>
                                <div class="table-info">
                                    <span class="table-icon">
                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">
                                            <rect x="3" y="8" width="18" height="3" rx="1" />
                                            <path d="M6 11v7" />
                                            <path d="M18 11v7" />
                                        </svg>
                                    </span>

                                    <div>
                                        <span class="table-label">Table</span>
                                        <strong>@order.TableId</strong>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <span class="total-price">
                                    @order.TotalPrice.ToString("F2")
                                </span>
                            </td>

                            <td>
                                <select class="status-select"
                                        data-order-id="@order.Id">

                                    @foreach (var status in Enum.GetValues<OrderStatus>())
                                    {
                                        <option value="@((int)status)"
                                                selected="@(status == order.OrderStatus)">
                                            @status
                                        </option>
                                    }

                                </select>
                            </td>

                            <td>
                                <span class="order-date">
                                    @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            @if (!Model.Any())
            {
                <div class="empty-orders">
                    <div class="empty-icon">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M6 3h12" />
                            <path d="M6 3v4a6 6 0 0 0 12 0V3" />
                            <path d="M12 13v8" />
                            <path d="M8 21h8" />
                        </svg>
                    </div>

                    <h3>No orders</h3>
                    <p>There are no orders in the last 24 Hours.</p>
                </div>
            }

        </div>

    </div>

</div>


@section Scripts {

    <script>

        document.querySelectorAll(".status-select").forEach(select => {

            // Save initial status
            select.dataset.previousStatus = select.value;

            select.addEventListener("change", async function() {

                const orderId = this.dataset.orderId;
                const newStatus = parseInt(this.value); const previousStatus = this.dataset.previousStatus;

                const row = this.closest(".order-row");

                this.disabled = true;

                // ...

                try {

                    const response = await fetch(
                        '@Url.Action("UpdateOrderStatus", "POS", new { area = "" })',
                        {
                            method: "POST",

                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken":
                                    document.querySelector(
                                        'input[name="__RequestVerificationToken"]'
                                    )?.value ?? ""
                            },

                            body: JSON.stringify({
                                orderId: orderId,
                                status: newStatus
                            })
                        }
                    );

                    const result = await response.json();

                    console.log("Server response:", result);

                    if (!response.ok) {
                        throw new Error(
                            result.message ?? "Failed to update order status."
                        );
                    }

                    // Completed => remove row
                    if (newStatus === 5 || newStatus === 4) {

                        row.style.opacity = "0";

                        setTimeout(() => {
                            row.remove();
                        }, 250);

                        return;
                    }

                    row.classList.remove(
                        "status-confirmed",
                        "status-preparing",
                        "status-pending",
                        "status-ready",
                    );

                    const statusClasses = {
                        0: "status-confirmed",
                        1: "status-preparing",
                        2: "status-pending",
                        3: "status-ready",
                    };

row.classList.add(statusClasses[newStatus]);
                    // Save new status
                    this.dataset.previousStatus = newStatus;

                    // Visual feedback
                    this.classList.add("status-updated");

                    setTimeout(() => {
                        this.classList.remove("status-updated");
                    }, 700);

                }
                catch (error) {

                    console.error(error);

                    if (previousStatus !== "") {
                        this.value = previousStatus;
                    }

                    alert(error.message || "Could not update order status.");

                }
                finally {

                    this.disabled = false;

                }

            });

        });
    </script>

}

                    
