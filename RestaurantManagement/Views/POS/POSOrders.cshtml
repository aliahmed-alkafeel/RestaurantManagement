@using RestaurantManagement.Areas.Dashboard.ViewModels
@using RestaurantManagement.Models

@model POSOrdersViewModel

@{
    ViewData["Title"] = "Orders";
}

<link rel="stylesheet"
      href="~/css/POSOrders.css" />

<div class="pos-orders"
     id="posOrders"
     data-update-status-url="@Url.Action("UpdateOrderStatus", "POS")"
     data-orders-url="@Url.Action("POSOrders", "POS")">

    <div class="orders-card">

        <!-- =================================================
             FILTER TOOLBAR
        ================================================== -->

        <div id="ordersFilterToolbar"
             class="orders-toolbar">

            <!-- Search -->

            <div class="search-box">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">

                    <circle cx="11"
                            cy="11"
                            r="7" />

                    <path d="m20 20-3.5-3.5" />

                </svg>

                <input type="search"
                       id="ordersSearch"
                       value="@Model.Filter.Search"
                       placeholder="Search table or item..." />

            </div>


            <!-- =================================================
                 SORT
            ================================================== -->
            @{
                var sortOptions = new[]
                {
                    (Value: "oldest", Text: "Oldest"),
                    (Value: "newest", Text: "Newest"),
                    (Value: "price-high", Text: "Highest Price"),
                    (Value: "price-low", Text: "Lowest Price")
                };

                var currentSort = string.IsNullOrEmpty(Model.Filter.Sort) ? "oldest" : Model.Filter.Sort;
                var currentSortText = sortOptions.FirstOrDefault(o => o.Value == currentSort).Text ?? "Oldest";
            }

            <div class="sort-select" id="sortFilter">

                <input type="hidden" id="ordersSort" value="@currentSort" />

                <button type="button" class="sort-select-button">
                    <span id="selectedSortText">@currentSortText</span>
                    <span class="sort-arrow"></span>
                </button>

                <div class="sort-select-menu">
                    @foreach (var option in sortOptions)
                    {
                        <button type="button"
                                class="sort-option @(option.Value == currentSort ? "selected" : "")"
                                data-sort="@option.Value">
                            @option.Text
                        </button>
                    }
                </div>

            </div>
                        <div class="status-select" id="statusFilter">

    @{
        string selectedText;
        string selectedClass;

        if (Model.Filter.ShowAllStatuses)
        {
            selectedText = "All";
            selectedClass = "status-all";
        }
        else if (Model.Filter.Status is null)
        {
            selectedText = "Default";
            selectedClass = "status-default";
        }
        else
        {
            selectedText = Model.Filter.Status.ToString();
            selectedClass =
                $"status-{Model.Filter.Status.ToString().ToLower()}";
        }
    }

    <button type="button"
            class="status-select-button">

        <span class="status-dot @selectedClass"></span>

        <span id="selectedStatusText">
            @selectedText
        </span>

        <span class="status-arrow">⌄</span>

    </button>


    <div class="status-select-menu">

        <button type="button"
                class="status-option status-default
                       @(Model.Filter.Status is null && !Model.Filter.ShowAllStatuses ? "selected" : "")"
                data-status="default">

            <span class="status-dot"></span>
            Default

        </button>


        <button type="button"
                class="status-option status-all
                       @(Model.Filter.ShowAllStatuses ? "selected" : "")"
                data-status="all">

            <span class="status-dot"></span>
            All

        </button>


        @foreach (var status in Enum.GetValues<OrderStatus>())
        {
            var statusClass =
                $"status-{status.ToString().ToLower()}";

            var isActive =
                Model.Filter.Status == status;

            <button type="button"
                    class="status-option @statusClass @(isActive ? "selected" : "")"
                    data-status="@((int)status)">

                <span class="status-dot"></span>

                @status

            </button>
        }

    </div>

</div>
            <div class="results-info">

                <strong id="ordersTotalCount">
                    @Model.TotalCount
                </strong>

                <span>
                    orders
                </span>

            </div>

            </div>


        <!-- =================================================
             ANTI FORGERY
        ================================================== -->

        @Html.AntiForgeryToken()

    </div>
        <!-- =================================================
             TABLE
        ================================================== -->
        <div class="orders-table-card">
        <div id="ordersTableWrapper"
             class="orders-table-wrapper">

            @await Html.PartialAsync(
                "_POSOrdersTable",
                Model)

        </div>


        </div>



</div>


@section Scripts {

    <script src="~/js/POSOrders.js"
            asp-append-version="true"></script>

}