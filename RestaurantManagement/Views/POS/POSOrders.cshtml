@using RestaurantManagement.Areas.Dashboard.ViewModels
@model List<OrderViewModel>

@{
    ViewData["Title"] = "Orders";
}

<link rel="stylesheet"
      href="~/css/POSOrders.css" />

<div class="pos-orders">

    <!-- Header -->
    <div class="pos-header">
        <div class="search-box">
            <svg viewBox="0 0 24 24" fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round">
                <circle cx="11" cy="11" r="7" />
                <path d="m21 21-4.3-4.3" />
            </svg>

            <input type="text"
                   id="search"
                   placeholder="Search table number..." />
        </div>
    </div>

    <!-- Orders -->
    <div class="orders-card">

        <div class="orders-table-wrapper">
            @Html.AntiForgeryToken()
            <table id="ordersTable" class="orders-table">

                <thead>
                    <tr>
                        <th>Table</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Order Date</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var order in Model)
                    {
                        <tr data-table="@order.TableId">

                            <td>
                                <div class="table-info">
                                    <span class="table-icon">
                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">
                                            <rect x="3" y="8" width="18" height="3" rx="1" />
                                            <path d="M6 11v7" />
                                            <path d="M18 11v7" />
                                        </svg>
                                    </span>

                                    <div>
                                        <span class="table-label">Table</span>
                                        <strong>@order.TableId</strong>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <span class="total-price">
                                    @order.TotalPrice.ToString("N0")
                                </span>
                            </td>

                            <td>
                                <select class="status-select"
                                        data-order-id="@order.Id">

                                    @foreach (var status in Enum.GetValues<OrderStatus>())
                                    {
                                        if (status == order.OrderStatus)
                                        {
                                            <option value="@status" selected>
                                                @status
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@status">
                                                @status
                                            </option>
                                        }
                                    }

                                </select>
                            </td>

                            <td>
                                <span class="order-date">
                                    @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            @if (!Model.Any())
            {
                <div class="empty-orders">
                    <div class="empty-icon">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M6 3h12" />
                            <path d="M6 3v4a6 6 0 0 0 12 0V3" />
                            <path d="M12 13v8" />
                            <path d="M8 21h8" />
                        </svg>
                    </div>

                    <h3>No orders</h3>
                    <p>There are currently no orders to display.</p>
                </div>
            }

        </div>

    </div>

</div>


@section Scripts {

    <script>

        // ==========================
        // Search
        // ==========================

        const searchInput = document.getElementById("search");
        const rows = document.querySelectorAll("#ordersTable tbody tr");

        searchInput.addEventListener("input", function() {

            const searchValue = this.value.toLowerCase().trim();

            rows.forEach(row => {

                const tableNumber = row.dataset.table.toLowerCase();

                row.style.display =
                    tableNumber.includes(searchValue)
                        ? ""
                        : "none";

            });

        });


        // ==========================
        // Change Order Status
        // ==========================

        document.querySelectorAll(".status-select").forEach(select => {

            select.addEventListener("change", async function() {

                const orderId = this.dataset.orderId;
                const newStatus = this.value;

                const previousStatus = this.dataset.previousStatus ?? "";

                // Prevent multiple requests
                this.disabled = true;

                try {

                    const response = await fetch(
                        '@Url.Action("UpdateOrderStatus", "POS", new { area = "" })',
                        {
                            method: "POST",

                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken":
                                    document.querySelector(
                                        'input[name="__RequestVerificationToken"]'
                                    )?.value ?? ""
                            },

                            body: JSON.stringify({
                                orderId: orderId,
                                status: newStatus
                            })
                        }
                    );

                    if (!response.ok) {
                        throw new Error("Failed to update order status.");
                    }

                    const result = await response.json();

                    if (!result.success) {
                        throw new Error(
                            result.message ?? "Failed to update order status."
                        );
                    }

                    // Save the new status
                    this.dataset.previousStatus = newStatus;

                    // Visual feedback
                    this.classList.add("status-updated");

                    setTimeout(() => {
                        this.classList.remove("status-updated");
                    }, 700);

                }
                catch (error) {

                    console.error(error);

                    // Return to previous value
                    if (previousStatus !== "") {
                        this.value = previousStatus;
                    }

                    alert("Could not update order status.");

                }
                finally {

                    this.disabled = false;

                }

            });

        });

    </script>

}

