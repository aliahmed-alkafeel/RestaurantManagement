@using RestaurantManagement.Areas.Dashboard.ViewModels
@using RestaurantManagement.Models

@model POSOrdersViewModel

@if (Model.Orders.Any())
{
    <table id="ordersTable"
           class="orders-table">

        <thead>

            <tr>

                <th>Table</th>

                <th>Total</th>

                <th>Status</th>

                <th>Items</th>

                <th>Order Date</th>

            </tr>

        </thead>


        <tbody>

            @foreach (var order in Model.Orders)
            {
                <tr data-table="@order.TableId"
                    data-order-id="@order.Id"
                    class="order-row status-@order.OrderStatus.ToString().ToLowerInvariant()">

                    <!-- =================================================
                         TABLE
                    ================================================== -->

                    <td>

                        <div class="table-info">

                            <span class="table-icon">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">

                                    <rect x="3"
                                          y="4"
                                          width="18"
                                          height="16"
                                          rx="2" />

                                    <path d="M8 4v16" />

                                    <path d="M16 4v16" />

                                </svg>

                            </span>


                            <div>

                                <span class="table-label">
                                    Table
                                </span>

                                <strong>
                                    @order.TableId
                                </strong>

                            </div>

                        </div>

                    </td>


                    <!-- =================================================
                         TOTAL
                    ================================================== -->

                    <td>

                        <span class="total-price">
                            @order.TotalPrice.ToString("F2")
                        </span>

                    </td>


                    <!-- =================================================
                         STATUS
                    ================================================== -->

                    <td>

                        <div class="status-actions">

                            <!-- Current Status -->

                            <button type="button"
                                    class="current-status-button status-@order.OrderStatus.ToString().ToLowerInvariant()"
                                    data-order-id="@order.Id"
                                    data-status="@((int)order.OrderStatus)"
                                    aria-expanded="false">

                                <span>
                                    @order.OrderStatus
                                </span>

                                <span class="status-chevron">
                                    ▾
                                </span>

                            </button>


                            <!-- Next Status -->

                            @if (order.OrderStatus != OrderStatus.Completed &&
                                 order.OrderStatus != OrderStatus.Cancelled)
                            {
                                <button type="button"
                                        class="next-status-button"
                                        data-order-id="@order.Id"
                                        data-status="@((int)order.OrderStatus)"
                                        title="Move to next status"
                                        aria-label="Move order to next status">

                                    <span class="next-arrow"></span>

                                </button>
                            }

                        </div>

                    </td>


                    <!-- =================================================
                         ITEMS
                    ================================================== -->

                    <td>

                        <div class="order-items">

                            @foreach (var item in order.ItemOrders)
                            {
                                <span class="order-item">

                                    <span class="item-name">
                                        @item.ItemName
                                    </span>

                                    <span class="item-quantity">
                                        × @item.Quantity
                                    </span>

                                </span>
                            }

                        </div>

                    </td>


                    <!-- =================================================
                         DATE
                    ================================================== -->

                    <td>

                        <time class="order-date"
                              data-utc="@DateTime.SpecifyKind(
                                  order.OrderDate,
                                  DateTimeKind.Utc
                              ).ToString("O")">
                        </time>

                    </td>

                </tr>
            }

        </tbody>

    </table>
}
else
{
    <div class="empty-orders">

        <div class="empty-icon">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2">

                <circle cx="12"
                        cy="12"
                        r="9" />

                <path d="M8 12h8" />

            </svg>

        </div>


        <h3>
            No orders found
        </h3>


        <p>
            Try changing your search or filters.
        </p>

    </div>
}