@using RestaurantManagement.Areas.Dashboard.ViewModels
@using RestaurantManagement.Models

@model POSOrdersViewModel

@if (Model.Orders.Any())
{
    <table id="ordersTable"
           class="orders-table">

        <thead>

            <tr>

                <th>Table</th>

                <th>Total</th>

                <th>Status</th>

                <th>Items</th>

                <th>Order Date</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var order in Model.Orders)
            {
                <tr data-table="@order.TableId"
                    data-order-id="@order.Id"
                    class="order-row status-@order.OrderStatus.ToString().ToLower()">

                    <!-- =================================================
                         TABLE
                    ================================================== -->

                    <td>

                        <div class="table-info">

                            <span class="table-icon">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">

                                    <rect x="3"
                                          y="4"
                                          width="18"
                                          height="16"
                                          rx="2" />

                                    <path d="M8 4v16" />

                                    <path d="M16 4v16" />

                                </svg>

                            </span>

                            <div>

                                <span class="table-label">
                                    Table
                                </span>

                                <strong>
                                    @order.TableId
                                </strong>

                            </div>

                        </div>

                    </td>


                    <!-- =================================================
                         TOTAL
                    ================================================== -->

                    <td>

                        <span class="total-price">
                            @order.TotalPrice.ToString("F2")
                        </span>

                    </td>


                    <!-- =================================================
                         STATUS
                    ================================================== -->

                    <td>

                        <div class="status-options"
                             data-order-id="@order.Id">

                            @foreach (var status in Enum.GetValues<OrderStatus>())
                            {
                                <button type="button"
                                        class="status-option status-@status.ToString().ToLower() @(order.OrderStatus == status ? "active" : "")"
                                        data-status="@((int)status)">

                                    @status

                                </button>
                            }

                        </div>

                    </td>


                    <!-- =================================================
                         ITEMS
                    ================================================== -->

                    <td>

                        <div class="order-items">

                            @foreach (var item in order.ItemOrders)
                            {
                                <span class="order-item">

                                    <span class="item-name">
                                        @item.ItemName
                                    </span>

                                    <span class="item-quantity">
                                        × @item.Quantity
                                    </span>

                                </span>
                            }

                        </div>

                    </td>


                    <!-- =================================================
                         DATE
                    ================================================== -->

                    <td>

                        <time class="order-date"
                              data-utc="@order.OrderDate.ToString("O")">
                        </time>

                    </td>

                </tr>
            }

        </tbody>

    </table>
}
else
{
    <div class="empty-orders">

        <div class="empty-icon">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2">

                <circle cx="12"
                        cy="12"
                        r="9" />

                <path d="M8 12h8" />

            </svg>

        </div>

        <h3>
            No orders found
        </h3>

        <p>
            Try changing your search or filters.
        </p>

    </div>
}