@using RestaurantManagement.Models
@using RestaurantManagement.Areas.Dashboard.ViewModels

@model IEnumerable<ItemViewModel>

@{
    ViewData["Title"] = "New Order";

    var items = Model?
        .Where(i => i.IsActive && i.IsAvailable)
        .ToList()
        ?? new List<ItemViewModel>();

    var categories = items
        .Where(i => i.Category != null)
        .Select(i => i.Category!)
        .GroupBy(c => c.Id)
        .Select(g => g.First())
        .ToList();

    var firstCategoryId = categories.FirstOrDefault()?.Id;
}


<!DOCTYPE html>

<html lang="en" dir="ltr">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Restaument
    </title>


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- Fonts -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
           />

    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet" />


    <!-- Project CSS -->

    <link rel="stylesheet"
          href="~/css/order.css"
          asp-append-version="true" />

</head>


<body class="has-sidebar">


    <!-- ================================================= -->
    <!-- TOP NAVBAR -->
    <!-- ================================================= -->



    <!-- ================================================= -->
    <!-- APPLICATION -->
    <!-- ================================================= -->

    <div class="order-app">


        <!-- ================================================= -->
        <!-- MOBILE OVERLAY -->
        <!-- ================================================= -->

        <div class="sidebar-overlay"
             id="sidebarOverlay">
        </div>


        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <aside class="sidebar"
               id="sidebar">


            <!-- Mobile sidebar header -->

            <div class="sidebar-mobile-header">




            </div>


            <!-- Sidebar content -->

            <div class="sidebar-content">



                <nav class="category-navigation">


                    @foreach (var type in Enum.GetValues<CategoryType>())
                    {

                        var typeCategories = categories
                            .Where(c => c.Type == type)
                            .ToList();


                        if (!typeCategories.Any())
                        {
                            continue;
                        }


                        <!-- Type -->

                        <div class="category-type">


                            <div class="type-title">

                                <span class="type-name">

                                    @type

                                </span>

                            </div>


                            <!-- Categories -->

                            <ul class="category-list">


                                @foreach (var category in typeCategories)
                                {

                                    var itemCount = items.Count(i =>
                                        i.CategoryId == category.Id);


                                    <li>


                                        <button type="button"
                                                class="category-button @(category.Id == firstCategoryId ? "active" : "")"
                                                data-category-id="@category.Id">


                                            <span class="category-name">

                                                @category.CategoryName

                                            </span>


                                            <span class="category-count">

                                                @itemCount

                                            </span>


                                        </button>


                                    </li>

                                }


                            </ul>


                        </div>

                    }


                </nav>


            </div>


        </aside>


        <!-- ================================================= -->
        <!-- MAIN -->
        <!-- ================================================= -->

        <div class="main-wrapper">


            <main class="order-page">


                <!-- ================================================= -->
                <!-- MENU -->
                <!-- ================================================= -->

                <section class="menu-section">


                    <!-- Menu header -->

                    <div class="menu-header">


                    

                        <!-- Search -->

                        <div class="search-container">


                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8">

                                <circle cx="11"
                                        cy="11"
                                        r="7" />

                                <path d="m20 20-4-4" />

                            </svg>


                            <input type="text"
                                   id="itemSearch"
                                   placeholder="Search menu..."
                                   autocomplete="off" />


                        </div>


                    </div>


                    <!-- Items -->

                    <div class="items-grid"
                         id="itemsGrid">


                        @foreach (var item in items)
                        {


                            <article class="item-card"
                                     data-item-id="@item.Id"
                                     data-category-id="@item.CategoryId"
                                     data-item-name="@item.ItemName.ToLowerInvariant()"
                                     data-item-price="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                     data-discount="@((item.DiscountPercentage ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))">


                                <!-- Image -->

                                <div class="item-image-wrapper">


                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {


                                        <img src="@Url.Content(item.ImageUrl)"
                                             alt="@item.ItemName"
                                             class="item-image" />


                                    }
                                    else
                                    {


                                        <div class="item-image-placeholder">


                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.5">

                                                <rect x="3"
                                                      y="3"
                                                      width="18"
                                                      height="18"
                                                      rx="2" />

                                                <circle cx="8.5"
                                                        cy="8.5"
                                                        r="1.5" />

                                                <path d="m21 15-5-5L5 21" />

                                            </svg>


                                        </div>


                                    }


                                    <!-- Add button -->

                                    <button type="button"
                                            class="add-item-button"
                                            aria-label="Add @item.ItemName">


                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2">

                                            <path d="M12 5v14" />
                                            <path d="M5 12h14" />

                                        </svg>


                                    </button>


                                </div>


                                <!-- Content -->

                                <div class="item-card-content">


                                    <h3 class="item-name">

                                        @item.ItemName

                                    </h3>


                                    <div class="item-card-bottom">


                                        <div class="item-price">

    @if (item.DiscountPercentage.HasValue &&
         item.DiscountPercentage.Value > 0)
    {
        var discountedPrice =
            item.Price * (1 - item.DiscountPercentage.Value / 100);

        <span class="original-price">
            $@item.Price.ToString("0.00")
        </span>

        <span class="discounted-price">
            $@discountedPrice.ToString("0.00")
        </span>
    }
    else
    {
        <span class="discounted-price">
            $@item.Price.ToString("0.00")
        </span>
    }

</div>

                                        <span class="item-action-text">

                                            Add

                                        </span>


                                    </div>


                                </div>


                            </article>


                        }


                    </div>


                    <!-- Empty search -->

                    <div class="empty-menu"
                         id="emptyMenu">


                        <div class="empty-icon">


                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.5">

                                <circle cx="11"
                                        cy="11"
                                        r="7" />

                                <path d="m20 20-4-4" />

                            </svg>


                        </div>


                        <h3>

                            No items found

                        </h3>


                        <p>

                            Try another search or category.

                        </p>


                    </div>


                </section>


                <!-- ================================================= -->
                <!-- CURRENT ORDER -->
                <!-- ================================================= -->

                <aside class="order-panel">


                    <!-- Header -->

                    <div class="order-panel-header">


                        <div>

                            <span class="order-kicker">

                                CURRENT ORDER

                            </span>


                        </div>


                        <span class="order-count"
                              id="orderCount">

                            0

                        </span>


                    </div>


                    <!-- Order items -->

                    <div class="order-items"
                         id="orderItems">


                        <div class="empty-order"
                             id="emptyOrder">







                        </div>


                    </div>


                    <!-- Footer -->

                    <div class="order-footer">


                        <!-- Table -->

                        <div class="table-field">


                            <label for="tableId">

                                Table

                            </label>


                            <input id="tableId"
                            placeholder="Enter table number..."        class="table-select"/>
                                



                        </div>


                        <!-- Total -->

                        <div class="total-section">


                            <div class="total-label">

                                Subtotal

                            </div>


                            <div class="total-price"
                                 id="orderTotal">

                                $0.00

                            </div>


                        </div>


                        <!-- Actions -->

                        <div class="order-actions">


                            <button type="button"
                                    class="clear-order-button"
                                    id="clearOrder">

                                Clear

                            </button>


                            <button type="button"
                                    class="create-order-button"
                                    id="createOrder">


                                <span>

                                    Create Order

                                </span>


                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">

                                    <path d="M5 12h14" />
                                    <path d="m13 6 6 6-6 6" />

                                </svg>


                            </button>


                        </div>


                    </div>


                </aside>


            </main>


        </div>


    </div>


    <!-- ================================================= -->
    <!-- BOOTSTRAP -->
    <!-- ================================================= -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <!-- ================================================= -->
    <!-- ORDER JAVASCRIPT -->
    <!-- ================================================= -->
    @Html.AntiForgeryToken()
    <script>

            document.addEventListener("DOMContentLoaded", function() {


                /* =================================================
                   ELEMENTS
                   ================================================= */

                const sidebar =
                    document.getElementById("sidebar");

                const sidebarOverlay =
                    document.getElementById("sidebarOverlay");

                const sidebarOpen =
                    document.getElementById("sidebarOpen");

                const sidebarClose =
                    document.getElementById("sidebarClose");


                const categoryButtons =
                    document.querySelectorAll(".category-button");

                const itemCards =
                    document.querySelectorAll(".item-card");


                const itemSearch =
                    document.getElementById("itemSearch");

                const emptyMenu =
                    document.getElementById("emptyMenu");


                const orderItems =
                    document.getElementById("orderItems");

                const emptyOrder =
                    document.getElementById("emptyOrder");

                const orderCount =
                    document.getElementById("orderCount");

                const orderTotal =
                    document.getElementById("orderTotal");


                const clearOrder =
                    document.getElementById("clearOrder");

                const createOrder =
                    document.getElementById("createOrder");

                const tableId =
                    document.getElementById("tableId");


                /* =================================================
                   ORDER STATE
                   ================================================= */

                const order = new Map();


                /* =================================================
                   CURRENT CATEGORY
                   ================================================= */

                let currentCategoryId =
                    document.querySelector(
                        ".category-button.active"
                    )?.dataset.categoryId ?? null;


                /* =================================================
                   SIDEBAR
                   ================================================= */

                function openSidebar() {

                    sidebar?.classList.add("open");

                    sidebarOverlay?.classList.add("show");

                    document.body.classList.add("sidebar-open");
                }


                function closeSidebar() {

                    sidebar?.classList.remove("open");

                    sidebarOverlay?.classList.remove("show");

                    document.body.classList.remove("sidebar-open");
                }


                sidebarOpen?.addEventListener(
                    "click",
                    openSidebar
                );


                sidebarClose?.addEventListener(
                    "click",
                    closeSidebar
                );


                sidebarOverlay?.addEventListener(
                    "click",
                    closeSidebar
                );


                /* =================================================
                   FILTER
                   ================================================= */

                function filterItems() {

                    const search =
                        itemSearch.value
                            .trim()
                            .toLowerCase();


                    let visibleCount = 0;


                    itemCards.forEach(card => {

                        const cardCategory =
                            card.dataset.categoryId;

                        const itemName =
                            card.dataset.itemName;


                        const matchesCategory =
                            !currentCategoryId ||
                            cardCategory === currentCategoryId;


                        const matchesSearch =
                            itemName.includes(search);


                        const visible =
                            matchesCategory &&
                            matchesSearch;


                        card.classList.toggle(
                            "hidden",
                            !visible
                        );


                        if (visible) {

                            visibleCount++;

                        }

                    });


                    emptyMenu.classList.toggle(
                        "show",
                        visibleCount === 0
                    );
                }


                /* =================================================
                   CATEGORY
                   ================================================= */

                function showCategory(categoryId) {

                    currentCategoryId =
                        categoryId;


                    categoryButtons.forEach(button => {

                        button.classList.toggle(
                            "active",
                            button.dataset.categoryId === categoryId
                        );

                    });


                    filterItems();

                    closeSidebar();
                }


                categoryButtons.forEach(button => {

                    button.addEventListener(
                        "click",
                        function() {

                            showCategory(
                                this.dataset.categoryId
                            );

                        }
                    );

                });


                /* =================================================
                   SEARCH
                   ================================================= */

                itemSearch.addEventListener(
                    "input",
                    filterItems
                );


                /* =================================================
                   INITIAL FILTER
                   ================================================= */

                filterItems();


                /* =================================================
                   ADD ITEM
                   ================================================= */

                itemCards.forEach(card => {

                    card.addEventListener(
                        "click",
                        function() {

                            const id =
                                this.dataset.itemId;

                            const name =
                                this.querySelector(
                                    ".item-name"
                                ).textContent.trim();

const price =
    Number(
        this.dataset.itemPrice
    );

const discount =
    Number(
        this.dataset.discount
    ) || 0;


                            if (
                                !id ||
                                !name ||
                                Number.isNaN(price)
                            ) {
                                return;
                            }

addToOrder(
    id,
    name,
    price,
    discount
);

                        }
                    );

                });


                /* =================================================
                   ADD TO ORDER
                   ================================================= */

function addToOrder(
    id,
    name,
    price,
    discount
) {

    if (order.has(id)) {

        const existingItem =
            order.get(id);

        existingItem.quantity++;

    }
    else {

        order.set(
            id,
            {
                id: id,
                name: name,
                price: price,
                discount: discount,
                quantity: 1
            }
        );

    }

    renderOrder();
}

                /* =================================================
                   RENDER ORDER
                   ================================================= */

                function renderOrder() {


                    orderItems
                        .querySelectorAll(".order-item")
                        .forEach(row => row.remove());


                    if (order.size === 0) {

                        emptyOrder.style.display =
                            "flex";

                    }
                    else {

                        emptyOrder.style.display =
                            "none";

order.forEach(item => {

    const row =
        document.createElement("div");

    row.className =
        "order-item";

    row.dataset.itemId =
        item.id;


    // Calculate final price

    const discountedPrice =
        item.discount > 0
            ? item.price *
              (1 - item.discount / 100)
            : item.price;


    // Price HTML

    const priceHtml =
        item.discount > 0
            ? `
                <span class="original-price">
                    $${item.price.toFixed(2)}
                </span>

                <span class="discounted-price">
                    $${discountedPrice.toFixed(2)}
                </span>
              `
            : `
                <span class="discounted-price">
                    $${item.price.toFixed(2)}
                </span>
              `;


    row.innerHTML = `

        <div class="order-item-info">

            <div class="order-item-name">

                ${escapeHtml(item.name)}

            </div>

            <div class="order-item-price">

                ${priceHtml}

            </div>

        </div>


        <div class="order-item-controls">


            <button
                type="button"
                class="quantity-button decrease"
                data-id="${item.id}">

                −

            </button>


            <span class="quantity">

                ${item.quantity}

            </span>


            <button
                type="button"
                class="quantity-button increase"
                data-id="${item.id}">

                +

            </button>


            <button
                type="button"
                class="remove-item"
                data-id="${item.id}"
                aria-label="Remove item">


                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8">

                    <path d="M4 7h16" />

                    <path d="M10 11v6" />

                    <path d="M14 11v6" />

                    <path d="M6 7l1 14h10l1-14" />

                    <path d="M9 7V4h6v3" />

                </svg>


            </button>


        </div>

    `;


    orderItems.appendChild(row);

});

                    }


                    updateSummary();
                }


                /* =================================================
                   QUANTITY / REMOVE
                   ================================================= */

                orderItems.addEventListener(
                    "click",
                    function(event) {


                        const button =
                            event.target.closest("button");


                        if (!button) {
                            return;
                        }


                        const id =
                            button.dataset.id;


                        if (!id || !order.has(id)) {
                            return;
                        }


                        const item =
                            order.get(id);


                        if (
                            button.classList.contains(
                                "increase"
                            )
                        ) {

                            item.quantity++;

                        }


                        else if (
                            button.classList.contains(
                                "decrease"
                            )
                        ) {

                            item.quantity--;


                            if (item.quantity <= 0) {

                                order.delete(id);

                            }

                        }


                        else if (
                            button.classList.contains(
                                "remove-item"
                            )
                        ) {

                            order.delete(id);

                        }


                        renderOrder();

                    }
                );


                /* =================================================
                   SUMMARY
                   ================================================= */

function updateSummary() {

    let total = 0;
    let count = 0;


    order.forEach(item => {


        const finalPrice =
            item.discount > 0
                ? item.price *
                  (1 - item.discount / 100)
                : item.price;


        total +=
            finalPrice *
            item.quantity;


        count +=
            item.quantity;

    });


    orderTotal.textContent =
        `$${total.toFixed(2)}`;


    orderCount.textContent =
        count;
}
                /* =================================================
                   CLEAR
                   ================================================= */

                clearOrder.addEventListener(
                    "click",
                    function() {


                        if (order.size === 0) {
                            return;
                        }


                        order.clear();

                        renderOrder();

                    }
                );


/* =================================================
   CREATE ORDER
   ================================================= */

createOrder.addEventListener(
    "click",
    async function () {

        if (order.size === 0) {

            alert("Please add at least one item.");

            return;
        }


        if (!tableId.value) {

            alert("Please enter a table number.");

            return;
        }


        const formData =
            new FormData();


        /* =========================================
           Anti Forgery Token
           ========================================= */

        const token =
            document.querySelector(
                'input[name="__RequestVerificationToken"]'
            )?.value;


        if (!token) {

            alert(
                "Anti-forgery token was not found."
            );

            return;
        }


        formData.append(
            "__RequestVerificationToken",
            token
        );


        /* =========================================
           Table
           ========================================= */

        formData.append(
            "TableId",
            tableId.value
        );


        /* =========================================
           Items
           ========================================= */

        Array.from(order.values())
            .forEach((item, index) => {

                formData.append(
                    `ItemOrders[${index}].ItemId`,
                    item.id
                );

                formData.append(
                    `ItemOrders[${index}].Quantity`,
                    item.quantity
                );

            });


        try {

            createOrder.disabled = true;


            const response =
                await fetch(
                    "/POS/CreateOrder",
                    {
                        method: "POST",
                        body: formData
                    }
                );


            console.log(
                "HTTP Status:",
                response.status
            );


            console.log(
                "Content-Type:",
                response.headers.get("content-type")
            );


            const responseText =
                await response.text();


            console.log(
                "Response:",
                responseText
            );


            if (!response.ok) {

                throw new Error(
                    `HTTP ${response.status}`
                );
            }


            if (!responseText.trim()) {

                throw new Error(
                    "Server returned an empty response."
                );
            }


            let result;

            try {

                result =
                    JSON.parse(responseText);

            }
            catch {

                throw new Error(
                    "Server did not return valid JSON."
                );
            }


            if (result.success) {

                alert(
                    result.message
                );


                order.clear();

                renderOrder();

                tableId.value = "";

            }
            else {

                alert(
                    result.message ??
                    "Could not create order."
                );

            }

        }
        catch (error) {

            console.error(
                "Create Order Error:",
                error
            );


            alert(
                error.message
            );

        }
        finally {

            createOrder.disabled = false;

        }

    }
);                /* =================================================
                   HTML ESCAPE
                   ================================================= */

                function escapeHtml(value) {

                    const div =
                        document.createElement("div");


                    div.textContent =
                        value;


                    return div.innerHTML;
                }


                /* =================================================
                   INITIAL ORDER
                   ================================================= */

                renderOrder();

            });

    </script>


</body>

</html>

