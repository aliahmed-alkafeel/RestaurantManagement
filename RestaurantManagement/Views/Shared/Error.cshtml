@model ErrorViewModel

@{
    ViewData["Title"] = "Error";
}

<div class="error-page">

    <div class="error-content">

        <div class="error-icon">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>

        <h1>Something went wrong</h1>

        <p>
            We're sorry, but something unexpected happened.
            Please try again later.
        </p>


        <a asp-controller="POS"
           asp-action="NewOrder"
           class="btn btn-primary">
            <i class="bi bi-house"></i>
            Back to Home
        </a>

    </div>

</div>

@section Styles {
    <style>
        .error-page {
            min-height: 75vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }

        .error-content {
            max-width: 600px;
            text-align: center;
        }

        .error-icon {
            font-size: 70px;
            color: #dc3545;
            margin-bottom: 20px;
        }

        .error-content h1 {
            font-size: 38px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .error-content p {
            color: #6c757d;
            font-size: 18px;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        .request-id {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 12px 18px;
            margin-bottom: 25px;
            font-size: 14px;
        }

            .request-id span {
                color: #6c757d;
            }

            .request-id code {
                margin-left: 5px;
            }

        .btn {
            padding: 10px 22px;
            border-radius: 8px;
        }
    </style>
}

