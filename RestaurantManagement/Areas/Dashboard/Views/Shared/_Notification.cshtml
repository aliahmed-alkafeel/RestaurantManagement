@if (TempData["SuccessMessage"] is string message)
{
    <div id="success-notification" class="success-notification">
        <i class="bi bi-check-circle-fill"></i>
        <span>@message</span>
    </div>
}

@if (TempData["WarningMessage"] is string warningMessage)
{
    <div id="warning-notification" class="warning-notification">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@warningMessage</span>
    </div>
}


