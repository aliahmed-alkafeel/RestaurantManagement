@model CategoryViewModel

@{
}

<div class="container-fluid employee-page">

    <div class="employee-form-wrapper">

        <div class="row justify-content-center w-100">
            <div class="col-12 col-xl-9 col-xxl-8">

                <!-- Employee Form Card -->
                <div class="card employee-card border-0 shadow-sm">

                    <!-- Card Header -->
                    <div class="card-header bg-transparent border-0 px-4 pt-4">
                        <div class="d-flex align-items-center gap-3">

                            <div>
                                <h5 class="mb-1 fw-bold">
                                    Add a new category
                                </h5>

                                <p class="text-muted mb-0">
                                    Enter the category details.
                                </p>
                            </div>

                        </div>
                    </div>


                    <!-- Card Body -->
                    <div class="card-body px-4 pb-4">

                        <form asp-area="Dashboard" asp-controller="Categories"
                              asp-action="CreateCategory"
                              method="post">
                            @Html.AntiForgeryToken()

                            <!-- Validation -->
                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3">
                            </div>


                            <!-- Personal Information -->
                            @* <div class="section-title">
                                <i class="ti ti-user"></i>
                                <span>Personal Information</span>
                            </div> *@

                            <div class="row">

                                <!-- First Name -->
                                <div class="col-md-6 mb-3">

                                    <label asp-for="CategoryName"
                                           class="form-label fw-semibold">
                                        Category Name
                                    </label>

                                    <input asp-for="CategoryName"
                                           class="form-control"
                                           placeholder="Enter Category name" />

                                    <span asp-validation-for="CategoryName"
                                          class="text-danger small">
                                    </span>

                                </div>



                                <div class="col-md-6 mb-3">
                                    <label asp-for="Type" class="form-label fw-semibold">
                                        Type
                                    </label>

                                    <select asp-for="Type"
                                            asp-items="Html.GetEnumSelectList<CategoryType>()"
                                            class="form-select">
                                        <option value="">Select Type</option>
                                    </select>

                                    <span asp-validation-for="Type"
                                          class="text-danger small">
                                    </span>
                                </div>

                            </div>
                            <br />

                            <!-- Actions -->
                            <div class="d-flex justify-content-end gap-2">

                                <a asp-controller="Dashboard"
                                   asp-action="Categories"
                                   class="btn btn-light border px-4">
                                    Cancel
                                </a>

                                <button type="submit"
                                        class="btn btn-primary px-4">

         

                                    Add Category

                                </button>

                            </div>

                        </form>

                    </div>
                </div>

            </div>
        </div>

    </div>

</div>


