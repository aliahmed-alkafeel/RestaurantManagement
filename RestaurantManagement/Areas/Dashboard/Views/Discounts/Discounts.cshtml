@model List<DiscountViewModel>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<header class="navbar">
    <div class="search-box">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
        <input type="text" id="search" placeholder="Search Items...">
    </div>
</header>
<div class="table-responsive">

<table class="table text-nowrap mb-0 align-middle">
    <thead class="text-dark fs-4">
        <tr>
            <th class="sort" data-sort="discount-name">
                <h6 class="fs-4 fw-semibold mb-0">Starting Date</h6>
            </th>
            <th>
                <h6 class="fs-4 fw-semibold mb-0">Ending Date</h6>
            </th>
            <th>
                <h6 class="fs-4 fw-semibold mb-0">Items Included</h6>
            </th>
            <th>
                <h6 class="fs-4 fw-semibold mb-0">Discount Percentage</h6>
            </th>

            <th>
                <h6 class="fs-4 fw-semibold mb-0">Operations</h6>
            </th>

        </tr>
    </thead>
    <tbody class="list">
        @foreach (var discount in Model)
        {
            <tr>
                    <td class="discount-name">
                  
                    @discount.DiscountStartingDate
                </td>
                <td>
                            @discount.DiscountEndingDate.ToString()                     
                </td>
                <td>
                        <div class="d-flex flex-wrap gap-1">
                        @foreach(Item item in discount.Items)
                        {                            
                            <span class="action showElements">@item.ItemName</span>              
                        }
                        </div>
                </td>
                    <td>
                        @discount.DiscountPercentage.ToString() + "%"
                    </td>
                <td>
                    <a class="action edit-action" asp-area="Dashboard" asp-controller="Discounts" asp-action="EditDiscount" asp-route-id="@discount.Id">Edit</a>
                    <a class="action delete-action" asp-area="Dashboard" asp-controller="Discounts"
                       asp-action="DeleteDiscount" asp-route-id="@discount.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
<a asp-area="Dashboard" asp-controller="Discounts"
   asp-action="CreateDiscount"
   class="add-btn">

    <svg viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round">
        <path d="M12 5v14" />
        <path d="M5 12h14" />
    </svg>

    Add New Discount
</a>


<script>
    const options = {
        valueNames: ["discount-name"]
    };
    const list = new List("itemTable", options);
    const searchInput = document.getElementById("search");
    searchInput.addEventListener("input", function() {
        list.search(this.value)
    });

</script>


  