@model List<GroupViewModel>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<table class="table text-nowrap mb-0 align-middle">
    <thead class="text-dark fs-4">
        <tr>
            <th>
                <h6 class="fs-4 fw-semibold mb-0">Group Name</h6>
            </th>
            <th>
                <h6 class="fs-4 fw-semibold mb-0">Roles</h6>
            </th>

            <th>
                <h6 class="fs-4 fw-semibold mb-0">Operations</h6>
            </th>

        </tr>
    </thead>
    <tbody>
            @foreach(var group in Model)
            {
        <tr>
            <td>
                 @group.GroupName.ToString()
            </td>
                <td>
                    <div class ="d-flex flex-wrap gap-1">

                    @foreach(var role in group.GroupRoles)
                        {
             <span class="action showElements">@role.Role.RoleName.ToString()</span>

                    }
                    </div>
            </td>
            <td>
              <a class="action edit-action" asp-area="Dashboard" asp-controller="Groups" asp-action="EditGroup" asp-route-id="@group.Id">Edit</a>
            </td>
        </tr>
        }
    </tbody>
</table>

  