@model GroupViewModel
<div class="container-fluid employee-page">

    <div class="employee-form-wrapper">

        <div class="row justify-content-center w-100">
            <div class="col-12 col-xl-9 col-xxl-8">

                <!-- Employee Form Card -->
                <div class="card employee-card border-0 shadow-sm">

                    <!-- Card Header -->
                    <div class="card-header bg-transparent border-0 px-4 pt-4">
                        <h2>Edit @Model.GroupName Roles</h2>
                        <div class="d-flex align-items-center gap-3">


<form asp-area="Dashboard" asp-controller="Groups" asp-action="EditGroup" method="post">
    <input type="hidden" asp-for="@Model.Id"/>

    <div class="mb-3">
        <div class="row g-2">

            @foreach (var role in Enum.GetValues<UserRole>())
            {
                <div class="col-6">

                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="@role"
                           name="Roles" value="@role" checked="@Model.GroupRoles.Any(gr => gr.Role.RoleName == role)" />

                    <label class="form-check-label"
                           for="@role">
                        @role
                    </label>
                </div>
                </div>
            }
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        Save
    </button>
    </form>
                        </div>
                        </div>

                    </div>
                </div>

            </div>

        </div>
        
        </div>