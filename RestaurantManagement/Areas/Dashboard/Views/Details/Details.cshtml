@model RestaurantManagement.Areas.Dashboard.ViewModels.DetailsViewModel

@{
    // ViewData["Title"] = "Dashboard";
}

<div class="dashboard-page">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="dashboard-header">

        <div>

            <h1>
                Dashboard
            </h1>

            <p>
                Restaurant performance overview
            </p>

        </div>

        <div class="dashboard-date">

            <i class="bi bi-calendar3"></i>

            @DateTime.Today.ToString("dd MMMM yyyy")

        </div>

    </div>


    <!-- =====================================================
         STATISTICS
         ===================================================== -->
    <div class="dashboard-stats">

        <!-- Total Sales -->
        <div class="stat-card">

            <div class="stat-info">
                <span class="stat-label">Total Sales</span>

                <h2>
                    @Model.TotalSales.ToString("N2")
                </h2>

            </div>

            <svg class="stat-svg"
                 viewBox="0 0 200 160"
                 xmlns="http://www.w3.org/2000/svg">

                <path d="M20 125
                C45 105 55 115 75 90
                S105 70 125 80
                S150 45 180 25"
                      fill="none"
                      stroke="#198754"
                      stroke-width="5"
                      stroke-linecap="round" />

                <path d="M20 125
                C45 105 55 115 75 90
                S105 70 125 80
                S150 45 180 25
                V160
                H20
                Z"
                      fill="#198754"
                      opacity=".08" />

                <circle cx="180"
                        cy="25"
                        r="7"
                        fill="#198754" />

            </svg>

        </div>


        <!-- Total Orders -->
        <div class="stat-card">

            <div class="stat-info">
                <span class="stat-label">Total Orders</span>

                <h2>
                    @Model.TotalOrders
                </h2>

            </div>

            <svg class="stat-svg"
                 viewBox="0 0 200 160"
                 xmlns="http://www.w3.org/2000/svg">

                <rect x="75"
                      y="20"
                      width="90"
                      height="115"
                      rx="12"
                      fill="none"
                      stroke="#0d6efd"
                      stroke-width="5" />

                <path d="M95 50H125"
                      stroke="#0d6efd"
                      stroke-width="5"
                      stroke-linecap="round" />

                <path d="M95 72H125"
                      stroke="#0d6efd"
                      stroke-width="5"
                      stroke-linecap="round" />

                <path d="M95 94H110"
                      stroke="#0d6efd"
                      stroke-width="5"
                      stroke-linecap="round" />

                <path d="M115 108
                L123 116
                L140 97"
                      fill="none"
                      stroke="#0d6efd"
                      stroke-width="5"
                      stroke-linecap="round"
                      stroke-linejoin="round" />

            </svg>

        </div>


        <!-- Today's Sales -->
        <div class="stat-card">

            <div class="stat-info">
                <span class="stat-label">Today's Sales</span>

                <h2>
                    @Model.TodaySales.ToString("N2")
                </h2>

            </div>

            <svg class="stat-svg"
                 viewBox="0 0 200 160"
                 xmlns="http://www.w3.org/2000/svg">

                <path d="M20 125
                L55 95
                L85 105
                L120 65
                L165 35"
                      fill="none"
                      stroke="#6f42c1"
                      stroke-width="6"
                      stroke-linecap="round"
                      stroke-linejoin="round" />

                <path d="M145 35H165V55"
                      fill="none"
                      stroke="#6f42c1"
                      stroke-width="6"
                      stroke-linecap="round"
                      stroke-linejoin="round" />

                <circle cx="20" cy="125" r="5" fill="#6f42c1" />
                <circle cx="55" cy="95" r="5" fill="#6f42c1" />
                <circle cx="85" cy="105" r="5" fill="#6f42c1" />
                <circle cx="120" cy="65" r="5" fill="#6f42c1" />
                <circle cx="165" cy="35" r="5" fill="#6f42c1" />

            </svg>

        </div>


        <!-- Today's Orders -->
        <div class="stat-card">

            <div class="stat-info">
                <span class="stat-label">Today's Orders</span>

                <h2>
                    @Model.TodayOrders
                </h2>

            </div>

            <svg class="stat-svg"
                 viewBox="0 0 200 160"
                 xmlns="http://www.w3.org/2000/svg">

                <path d="M35 35
                H55
                L68 105
                H155
                L170 55
                H62"
                      fill="none"
                      stroke="#fd7e14"
                      stroke-width="6"
                      stroke-linecap="round"
                      stroke-linejoin="round" />

                <circle cx="85"
                        cy="125"
                        r="8"
                        fill="#fd7e14" />

                <circle cx="145"
                        cy="125"
                        r="8"
                        fill="#fd7e14" />

                <path d="M95 78
                L108 90
                L135 62"
                      fill="none"
                      stroke="#fd7e14"
                      stroke-width="6"
                      stroke-linecap="round"
                      stroke-linejoin="round" />

            </svg>

        </div>

    </div>
    <!-- =====================================================
         SALES + TOP SELLING
         ===================================================== -->

    <div class="dashboard-grid dashboard-grid-main">


        <!-- SALES OVERVIEW -->

        <div class="dashboard-card">

            <div class="card-header">

                <div>

                    <h3>
                        Sales Overview
                    </h3>

                    <p>
                        Sales during the last 7 days
                    </p>

                </div>

            </div>


            <div class="sales-chart-wrapper">

                <canvas id="salesChart"></canvas>

            </div>

        </div>


        <!-- TOP SELLING -->

        <div class="dashboard-card">

            <div class="card-header">

                <div>

                    <h3>
                        Top Selling Items
                    </h3>

                    <p>
                        Best selling items overall
                    </p>

                </div>

            </div>


            <div class="ranking-list">

                @if (Model.TopSellingItems.Any())
                {
                    var rank = 1;

                    foreach (var item in Model.TopSellingItems)
                    {
                        <div class="ranking-item">

                            <div class="rank-number">
                                @rank
                            </div>

                            <div class="ranking-info">

                                <strong>
                                    @item.ItemName
                                </strong>

                                <small>
                                    @item.Quantity items sold
                                </small>

                            </div>

                            <span class="ranking-value">

                                @item.TotalSales.ToString("N2")

                            </span>

                        </div>

                        rank++;
                    }
                }
                else
                {
                    <div class="empty-dashboard">
                        No sales data available.
                    </div>
                }

            </div>

        </div>

    </div>


    <!-- =====================================================
         CATEGORY + TODAY
         ===================================================== -->

    <div class="dashboard-grid dashboard-grid-secondary">


        <!-- SALES BY CATEGORY -->

        <div class="dashboard-card">

            <div class="card-header">

                <div>

                    <h3>
                        Sales by Category
                    </h3>

                    <p>
                        Revenue generated by each category
                    </p>

                </div>

            </div>


            <div class="category-list">

                @if (Model.SalesByCategory.Any())
                {
                    var maxCategorySales =
                        Model.SalesByCategory.Max(x => x.TotalSales);

                    foreach (var category in Model.SalesByCategory)
                    {
                        var percentage =
                            maxCategorySales == 0
                                ? 0
                                : (double)
                                    (category.TotalSales /
                                    maxCategorySales * 100);

                        <div class="category-row">

                            <div class="category-title">

                                <span>
                                    @category.CategoryName
                                </span>

                                <strong>
                                    @category.TotalSales.ToString("N2")
                                </strong>

                            </div>


                            <div class="progress">

                                <div class="progress-bar"
                                     style="width:@percentage.ToString("0.##")%">
                                </div>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="empty-dashboard">
                        No category sales available.
                    </div>
                }

            </div>

        </div>


        <!-- MOST POPULAR TODAY -->

        <div class="dashboard-card">

            <div class="card-header">

                <div>

                    <h3>
                        Most Popular Today
                    </h3>

                    <p>
                        Most ordered items today
                    </p>

                </div>

            </div>


            <div class="ranking-list">

                @if (Model.MostPopularToday.Any())
                {
                    var rank = 1;

                    foreach (var item in Model.MostPopularToday)
                    {
                        <div class="ranking-item">

                            <div class="rank-number">

                                    @rank
                           
                            </div>


                            <div class="ranking-info">

                                <strong>
                                    @item.ItemName
                                </strong>

                                <small>
                                    @item.Quantity sold today
                                </small>

                            </div>


                            <span class="ranking-value">

                                @item.TotalSales.ToString("N2")

                            </span>

                        </div>

                        rank++;
                    }
                }
                else
                {
                    <div class="empty-dashboard">
                        No orders today.
                    </div>
                }

            </div>

        </div>

    </div>

</div>



    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const salesLabels =
            @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                            Model.SalesLast7Days.Select(x =>
                                    x.Date.ToString("ddd"))
                    )
            );


        const salesData =
            @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                            Model.SalesLast7Days.Select(x =>
                                    x.Sales)
                    )
            );


        const ctx =
            document.getElementById("salesChart");


        new Chart(ctx,
        {
            type: "line",

            data:
            {
                labels: salesLabels,

                datasets:
                [
                    {
                        label: "Sales",

                        data: salesData,

                        tension: 0.35,

                        fill: true
                    }
                ]
            },

            options:
            {
                responsive: true,

                maintainAspectRatio: false,

                plugins:
                {
                    legend:
                    {
                        display: false
                    }
                },

                scales:
                {
                    y:
                    {
                        beginAtZero: true,

                        ticks:
                        {
                            callback: function(value)
                            {
                                return value.toLocaleString();
                            }
                        }
                    },

                    x:
                    {
                        grid:
                        {
                            display: false
                        }
                    }
                }
            }
        });

    </script>


