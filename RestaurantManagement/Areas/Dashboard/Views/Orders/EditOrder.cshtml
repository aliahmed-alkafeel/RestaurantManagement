@model OrderViewModel

@{
}
<style>
    .item-price-display {
    display: flex;
    align-items: center;
    gap: 8px;
}

.original-price {
    text-decoration: line-through;
    opacity: 0.5;
    font-size: 0.85rem;
}

.discounted-price {
    font-weight: 600;
}
</style>
<div class="container-fluid employee-page">

    <div class="employee-form-wrapper">

        <div class="row justify-content-center w-100">
            <div class="col-12 col-xl-9 col-xxl-8">

                <!-- Employee Form Card -->
                <div class="card employee-card border-0 shadow-sm">

                    <!-- Card Header -->
                    <div class="card-header bg-transparent border-0 px-4 pt-4">
                        <div class="d-flex align-items-center gap-3">

                            <div>
                                <h5 class="mb-1 fw-bold">
                                    Edit an order
                                </h5>

                                <p class="text-muted mb-0">
                                    Do you want to edit this order?
                                </p>
                            </div>

                        </div>
                    </div>


                    <!-- Card Body -->
                    <div class="card-body px-4 pb-4">

                        <form asp-area="Dashboard" asp-controller="Orders"
                              asp-action="EditOrder"
                              asp-route-id="@Model.Id"
                              method="post">
                            @Html.AntiForgeryToken()

                            <!-- Validation -->
                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3">
                            </div>

                            <div class="row">

                                <!-- First Name -->
                                <div class="col-md-6 mb-3">

                                    <label asp-for="TableId"
                                           class="form-label fw-semibold">
                                        Table Number
                                    </label>
                                    <input  asp-for="TableId"
                                           class="form-control"
                                           placeholder="Enter Table Number" />
                                    <span asp-validation-for="TableId"
                                          class="text-danger small">
                                    </span>
                                </div>
                                <div class="col-md-6 mb-3">

                                    <label asp-for="OrderStatus"
                                           class="form-label fw-semibold">
                                        Status
                                    </label>

                                    <select asp-for="OrderStatus"
                                            asp-items="Html.GetEnumSelectList<OrderStatus>()"
                                            class="form-select">
                                        <option value="">Select Status</option>
                                    </select>


                                    <span asp-validation-for="OrderStatus"
                                          class="text-danger small">
                                    </span>
                                </div>
                                <div class="col-md-6 mb-3">

                                    <label asp-for="OrderDate"
                                           class="form-label fw-semibold">
                                        Order Date
                                    </label>

                                    <input  asp-for="OrderDate"
                                           type="datetime-local"
                                           class="form-control" />

                                    <span asp-validation-for="OrderDate"
                                          class="text-danger small">
                                    </span>

                                </div>

  
                            <div>
                                <h5>Items</h5>
                                <div class="table-responsive">

                                    <table id="table" class="table text-nowrap mb-0 align-middle">
                                        <thead class="text-dark fs-4">
                                            <tr>
                                                <th>
                                                    <h6 class="fs-3 fw-semibold mb-0">Item Name</h6>
                                                </th>
                                                <th>
                                                    <h6 class="fs-3 fw-semibold mb-0">Price</h6>
                                                </th>
                                                <th>
                                                    <h6 class="fs-3 fw-semibold mb-0">Quantity</h6>
                                                </th>
                                                <th>
                                                    @null
                                                </th>

                                            </tr>
                                        </thead>
                                        <tbody id="itemsTableBody" class="list">
                                        </tbody>
                                    </table>
                                </div>
                                    <button type="button" id="addItemBtn" data-bs-toggle="modal"
                                            data-bs-target="#addItemModal" class="add-btn">
                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <path d="M12 5v14" />
                                        <path d="M5 12h14" />
                                    </svg>
                                    Add New Item
                                </button>
                            </div>

                                <div id="itemOrdersContainer"></div>
                                <br />
                                <!-- Actions -->
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-controller="Dashboard"
                                       asp-action="Orders"
                                       class="btn btn-light border px-4">
                                        Cancel
                                    </a>

                                    <button type="submit"
                                            class="btn btn-primary px-4">
                                        Edit
                                    </button>
                                   </div>
                                </div>
                        </form>

                    </div>
                </div>

            </div>
        </div>

    </div>

</div>
    <div class="modal fade" id="addItemModal" tabindex="-1"
         aria-labelledby="addItemModalLabel"
         aria-hidden="true">

        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="addItemModalLabel">
                        Add Item
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">

                    <!-- Type -->
                    <div class="mb-3">
                        <label for="itemType" class="form-label">
                            Type
                        </label>

                        <select id="itemType" class="form-select">
                            <option value="">
                                Select Type
                            </option>

                            @foreach (var type in Enum.GetValues<CategoryType>())
                            {
                                <option value="@((int)type)">
                                    @type.ToString()
                                </option>
                            }
                        </select>
                    </div>


                    <!-- Category -->
                    <div class="mb-3">
                        <label for="itemCategory" class="form-label">
                            Category
                        </label>

                        <select id="itemCategory"
                                class="form-select"
                                disabled>

                            <option value="">
                                Select Category
                            </option>
                        </select>
                    </div>


                    <!-- Item -->
                    <div class="mb-3">
                        <label for="itemSelect" class="form-label">
                            Item
                        </label>

                        <select id="itemSelect"
                                class="form-select"
                                disabled>

                            <option value="">
                                Select Item
                            </option>
                        </select>
                    </div>


                    <!-- Quantity -->
                    <div class="mb-3">
                        <label for="itemQuantity" class="form-label">
                            Quantity
                        </label>

                        <input type="number"
                               id="itemQuantity"
                               class="form-control"
                               min="1"
                               value="1">
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            id="confirmAddItem">
                        Add Item
                    </button>

                </div>

            </div>
        </div>
    </div>
<script>
const initialOrderItems = @Html.Raw(
    System.Text.Json.JsonSerializer.Serialize(
        Model.ItemOrders.Select(x => new
        {
            itemId = x.ItemId,
            itemName = x.ItemName,
            price = x.Price,
            discountPercentage = x.DiscountPercentage,
            quantity = x.Quantity
        })
    )
);
</script>

<script src="~/js/addingItemsModal.js"></script>
